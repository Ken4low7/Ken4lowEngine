<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Phase 16のGPU Fluid実装を既存巨大vcxprojへ直接追記せず、main projectだけへ追加登録する。 -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Ken4lowEngine'">
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Resource\GpuFluidGridResource.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidVelocityAdvectionPass.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidPressureProjectionPass.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidScalarAdvectionPass.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidForcePass.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Data\GpuFluidTypes.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Resource\GpuFluidGridResource.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidVelocityAdvectionPass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidPressureProjectionPass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidScalarAdvectionPass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Renderer\GpuFluid\Pass\GpuFluidForcePass.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Engine\Graphics\Shader\Manifest\GpuFluidShaderManifest.h" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidCommon.hlsli" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidVelocityAdvection.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidDivergence.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidPressureJacobi.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidProjection.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidScalarAdvection.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidVorticityCurl.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidVorticityConfinement.CS.hlsl" />
    <None Include="$(MSBuildThisFileDirectory)Resources\Shaders\GpuFluid\GpuFluidBuoyancy.CS.hlsl" />
  </ItemGroup>
</Project>
